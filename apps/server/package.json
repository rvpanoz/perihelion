    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@perihelion/fixtures": "^0.0.0",
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
